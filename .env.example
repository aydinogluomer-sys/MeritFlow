# =============================================================================
# MeritFlow — environment variables (example; copy to .env.local and fill in)
# Local values come from `npm run -s db:reset` output or `supabase status`.
# .env.local is gitignored. NEVER commit real keys.
# =============================================================================

# --- Supabase (PUBLIC — safe to expose to the browser; protected by RLS) ------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# --- Supabase service role (SERVER-ONLY SECRET) -------------------------------
# HARD RULE (SI-11): never prefix with NEXT_PUBLIC_, never log, never ship to the
# client bundle. Used ONLY inside src/lib/supabase/admin.ts (import 'server-only').
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# --- Observability (OPTIONAL) -------------------------------------------------
# Sentry is a no-op unless SENTRY_DSN is set (Decision C). No session replay /
# no employee monitoring — errors only, PII scrubbed.
SENTRY_DSN=
SENTRY_ENV=development
